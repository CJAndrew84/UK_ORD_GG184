# ================================================================================			
#
# Syntax:			
# TYPE <DataGroup Type>
#	ITEM <Datagroup Item> EXPORT_AS  <IfcEntityClass>.<IfcTypeClass>.<No(_of_IfcPredefinedType)>:<IfcPredefinedType>
#	
# ================================================================
#
TYPE Curtain Wall

	ITEM A-Curtainwall-FullFrameEqualSpacedMullions* EXPORT_AS IfcCurtainWall.IfcCurtainWallType.1
	ITEM S-Curtainwall-FullFrameEqualSpacedMullions* EXPORT_AS IfcCurtainWall.IfcCurtainWallType.1
#
Type PlumbingFixtures

	
	ITEM A-Bathtub-1800-800-CentreDrain-2D* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.0
	ITEM A-Bidet-2D* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.1
	ITEM A-Shower-900x900-2D* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.11
	ITEM A-Toilet-2D* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.6
	ITEM A-Urinal-2D* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.7
	ITEM A-Bathtub-Rectangular01-1800x800* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.0
	ITEM A-Urinal-WallMounted01* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.7
	ITEM A-Sink-DoubleEqual* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.4
	ITEM A-Bidet-470x620* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.1
#	ITEM A-Radiator01* EXPORT_AS 
	ITEM A-Shower-Corner01-900x900* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.11
#	ITEM A-Tap-Kitchen Tap Mixer 1* EXPORT_AS 
	ITEM A-WC-Cistern02* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.6
	ITEM A-WC-FloorMounted-ConcealedCistern02* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.6
	ITEM A-Sink-Single* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.4
	ITEM A-Sink-RoundBowl-475mm* EXPORT_AS IfcFlowTerminal.IfcSanitaryTerminalType.4

