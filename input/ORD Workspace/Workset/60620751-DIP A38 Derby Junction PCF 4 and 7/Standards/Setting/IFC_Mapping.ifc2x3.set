# for IFC Export to FM Handover/COBie spreadsheet, comment out line PROPERTY_TABLE "IFC_PropertyMapping.set" above and uncomment the following line:  
# PROPERTY_TABLE "IFC_PropertyMapping_COBie.set"

PROPERTY_TABLE "IFC_PropertyMapping_local.ifc2x3.set"

