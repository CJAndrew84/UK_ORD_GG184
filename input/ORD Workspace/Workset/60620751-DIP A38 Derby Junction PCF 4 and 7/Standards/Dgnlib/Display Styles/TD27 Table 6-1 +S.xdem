<?xml version="1.0" encoding="utf-8"?>
<DEMFilter>
	<style>Elevation</style>
	<hillShade>true</hillShade>
	<verticalExaggeration>1</verticalExaggeration>
	<clipToEndValues>false</clipToEndValues>
	<defaultColor>
		<red>63</red>
		<green>63</green>
		<blue>63</blue>
	</defaultColor>
	<upperRanges>
		<upperRange>
			<value>10.000000</value>
			<state>true</state>
			<color>
				<red>36</red>
				<green>255</green>
				<blue>20</blue>
			</color>
		</upperRange>
		<upperRange>
			<value>5.490000</value>
			<state>true</state>
			<color>
				<red>28</red>
				<green>149</green>
				<blue>255</blue>
			</color>
		</upperRange>
		<upperRange>
			<value>5.110000</value>
			<state>true</state>
			<color>
				<red>255</red>
				<green>24</green>
				<blue>8</blue>
			</color>
		</upperRange>
	</upperRanges>
</DEMFilter>