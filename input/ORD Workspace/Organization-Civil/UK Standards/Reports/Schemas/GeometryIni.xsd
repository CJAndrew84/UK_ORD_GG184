    <element name="GeometryViewOptions">
        <annotation>
            <documentation>Contains View Options settings for Geometry View commands</documentation>
        </annotation>
        <complexType>
            <attribute name="ItemName" type="ini:STString31" use="required"/>
            <attribute name="ViewHorizontalElementAnnotation" type="boolean" use="required"/>
            <attribute name="ViewVerticalElementAnnotation" type="boolean" use="required"/>
            <attribute name="ViewClosedAreas" type="boolean" use="required"/>
            <attribute name="ViewStationing" type="boolean" use="required"/>
            <attribute name="ViewCurveSets" type="boolean" use="required"/>
            <attribute name="ViewVerticalInPlan" type="boolean" use="required"/>
            <attribute name="ViewRegressionPoints" type="boolean" use="required"/>
        </complexType>
    </element>
    <element name="GeometryViewOptionsCollection">
        <annotation>
            <documentation>Collection of Geometry View Options preferences</documentation>
        </annotation>
        <complexType>
            <sequence>
                <element ref="ini:GeometryViewOptions" maxOccurs="unbounded"/>
            </sequence>
        </complexType>
    </element>
    <element name="ViewHorizontalAnnotation">
        <annotation>
            <documentation>Contains View Horizontal Annotation settings</documentation>
        </annotation>
        <complexType>
            <sequence>
                <element name="LineTable" type="ini:CTAnnotationPlacement"/>
                <element name="CircleTable" type="ini:CTAnnotationPlacement"/>
                <element name="SpiralTable" type="ini:CTAnnotationPlacement"/>
                <element name="SingleTable" type="ini:CTAnnotationPlacement" minOccurs="0"/>
            </sequence>
            <attribute name="ItemName" type="ini:STString31" use="required"/>
            <attribute name="ApplyStyle" use="required">
                <annotation>
                    <documentation>
                        0 = Assigned
                        1 = Active
                    </documentation>
                </annotation>
                <simpleType>
                    <restriction base="integer">
                        <enumeration value="0"/>
                        <enumeration value="1"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="OverwriteStyle" type="boolean" use="required"/>
            <attribute name="Complex" type="boolean" use="required"/>
            <attribute name="DisplayPoints" type="boolean" use="required"/>
            <attribute name="DisplayOnAlignmentPoints" type="boolean" use="required"/>
            <attribute name="DisplayOffAlignmentPoints" type="boolean" use="required"/>
            <attribute name="DisplayElements" type="boolean" use="required"/>
            <attribute name="DisplayRadials" type="boolean" use="required"/>
            <attribute name="DisplayChords" type="boolean" use="required"/>
            <attribute name="DisplayTangents" type="boolean" use="required"/>
            <attribute name="DisplaySubtangents" type="boolean" use="required"/>
            <attribute name="AnnotatePoints" type="boolean" use="required"/>
            <attribute name="AnnotateElements" type="boolean" use="required"/>
            <attribute name="AnnotateDuplicates" type="boolean" use="required"/>
            <attribute name="AnnotateDualDimension" type="boolean" use="required"/>
            <attribute name="UseAlternates" type="boolean" use="required"/>
            <attribute name="CreateTable" type="boolean" use="optional"/>
            <attribute name="Tabling" use="required">
                <annotation>
                    <documentation>
                        0 = None
                        1 = Basic Element Information
                        2 = All Element Information
                    </documentation>
                </annotation>
                <simpleType>
                    <restriction base="integer">
                        <minInclusive value="0"/>
                        <maxInclusive value="2"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="UseSingleTable" type="boolean" use="optional"/>
            <attribute name="LineTableSeedNumber" type="integer" use="required"/>
            <attribute name="CircleTableSeedNumber" type="integer" use="required"/>
            <attribute name="SpiralTableSeedNumber" type="integer" use="required"/>
            <attribute name="SingleTableSeedNumber" type="integer" use="optional"/>
            <attribute name="OmitElementNaming" type="boolean" use="required"/>
            <attribute name="Planarize" type="boolean" use="required"/>
            <attribute name="AnnotateBeyondElement" type="boolean" use="required"/>
            <attribute name="DisplayEvents" type="boolean" use="required"/>
            <attribute name="DisplayEquations" type="boolean" use="required"/>
            <attribute name="ActiveStyle" type="ini:STString31" use="required"/>
            <attribute name="PCPointStyle" type="ini:STString31" use="required"/>
            <attribute name="CCPointStyle" type="ini:STString31" use="required"/>
            <attribute name="PIPointStyle" type="ini:STString31" use="required"/>
