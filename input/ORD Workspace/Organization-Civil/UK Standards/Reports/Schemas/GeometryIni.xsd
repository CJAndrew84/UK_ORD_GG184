            <attribute name="EquationPointStyle" type="ini:STString31" use="required"/>
            <attribute name="CogoStyle" type="ini:STString31" use="required"/>
            <attribute name="RadialsStyle" type="ini:STString31" use="required"/>
            <attribute name="ChordsStyle" type="ini:STString31" use="required"/>
            <attribute name="TangentsStyle" type="ini:STString31" use="required"/>
            <attribute name="SubtangentsStyle" type="ini:STString31" use="required"/>
