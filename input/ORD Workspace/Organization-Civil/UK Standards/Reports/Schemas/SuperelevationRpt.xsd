	<simpleType name="SuperelevationTransitionType">
		<annotation>
			<documentation>A list of superelevation transition types</documentation>
		</annotation>
		<restriction base="string">
			<enumeration value="Linear"/>
			<enumeration value="Parabolic"/>
			<enumeration value="ReverseParabolic"/>
			<enumeration value="ReverseBiquadratic"/>
			<enumeration value="ReverseCubic"/>
			<enumeration value="ReverseSymmetrical"/>
		</restriction>
	</simpleType>
	<simpleType name="SuperelevationPointType">
		<annotation>
			<documentation>A list of superelevation point types</documentation>
		</annotation>
		<restriction base="string">
			<enumeration value="UndefinedType"/>
			<enumeration value="NormalCrown"/>
			<enumeration value="SuperRunoff"/>
			<enumeration value="ReverseCrown"/>
			<enumeration value="FullSuper"/>
			<enumeration value="NormalCrownIn"/>
			<enumeration value="NormalCrownOut"/>
			<enumeration value="SuperRunoffIn"/>
			<enumeration value="SuperRunoffOut"/>
			<enumeration value="ReverseCrownIn"/>
			<enumeration value="ReverseCrownOut"/>
			<enumeration value="FullSuperIn"/>
			<enumeration value="FullSuperOut"/>
		</restriction>
	</simpleType>
