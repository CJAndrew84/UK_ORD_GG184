	<element name="SuperelevationTransition">
		<annotation>
			<documentation>Superelevation transition data</documentation>
		</annotation>
		<complexType mixed="true">
			<complexContent>
				<extension base="inr:CTStation">
					<sequence>
						<element ref="inr:SuperelevationTransitionStandards" minOccurs="0" maxOccurs="1"/>
					</sequence>
					<attribute name="name" type="string" use="required"/>
					<attribute name="crossSlope" type="double" use="required"/>
					<attribute name="type" type="inr:SuperelevationPointType" use="required"/>
					<attribute name="transitionType" type="inr:SuperelevationTransitionType" use="required"/>
