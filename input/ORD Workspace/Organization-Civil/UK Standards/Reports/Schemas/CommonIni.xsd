        <restriction base="string">
            <maxLength value="31"/>
        </restriction>
    </simpleType>
    <simpleType name="STString39">
        <restriction base="string">
            <maxLength value="39"/>
        </restriction>
    </simpleType>
    <simpleType name="STString63">
        <restriction base="string">
            <maxLength value="63"/>
        </restriction>
    </simpleType>
    <simpleType name="STString79">
        <restriction base="string">
            <maxLength value="79"/>
        </restriction>
    </simpleType>
    <simpleType name="STString127">
        <restriction base="string">
            <maxLength value="127"/>
        </restriction>
    </simpleType>
    <simpleType name="STString255">
        <restriction base="string">
            <maxLength value="255"/>
        </restriction>
    </simpleType>
    <simpleType name="STString511">
        <restriction base="string">
            <maxLength value="511"/>
