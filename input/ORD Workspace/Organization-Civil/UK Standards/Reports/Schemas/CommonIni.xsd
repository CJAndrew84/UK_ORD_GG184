    <simpleType name="STNonnegativeDouble">
        <restriction base="double">
            <minInclusive value="0"/>
        </restriction>
    </simpleType>
    <simpleType name="STColorValue">
        <annotation>
            <documentation>Sets valid range for color values</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="255"/>
        </restriction>
    </simpleType>
    <simpleType name="STExtendedColorValue">
        <annotation>
            <documentation>Sets valid range for color values, -1 indicates "By Level"</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="-1"/>
            <maxInclusive value="255"/>
        </restriction>
    </simpleType>
    <simpleType name="STWeight">
        <annotation>
            <documentation>Sets valid range for line and text weights</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="-1"/>
            <maxInclusive value="255"/>
        </restriction>
    </simpleType>
    <simpleType name="STJustification">
        <annotation>
            <documentation>
                External values are AutoCAD; converted to MicroStation values in code
                0 = Top Left
                1 = Top Center
                2 = Top Right
                3 = Center/Middle Left
                4 = Center/Middle Center
                5 = Center/Middle Right
                6 = Bottom Left
                7 = Bottom Center
                8 = Bottom Right
                9 - 14 Needs help
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="14"/>
        </restriction>
    </simpleType>
    <simpleType name="STPointDisplayType">
        <annotation>
            <documentation>
                4 = Symbol
                8 = Triangle
                16 = Inverted Triangle
                32 = Circle
                64 = Square
                128 = Plus Sign
                256 = Cross
                512 = Dumbbell
                1024 = Target
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="4"/>
            <enumeration value="8"/>
            <enumeration value="16"/>
            <enumeration value="32"/>
            <enumeration value="64"/>
            <enumeration value="128"/>
            <enumeration value="256"/>
            <enumeration value="512"/>
            <enumeration value="1024"/>
        </restriction>
    </simpleType>
    <simpleType name="STAngle">
        <annotation>
            <documentation>Sets valid range for angles</documentation>
        </annotation>
        <restriction base="double">
            <minInclusive value="-400.0"/>
            <maxExclusive value="400.0"/>
        </restriction>
    </simpleType>
    <simpleType name="STDirection">
        <annotation>
            <documentation>Sets valid range for direction from 0.0 to 2*PI in radians (North Azimuth)</documentation>
        </annotation>
        <restriction base="double">
            <minInclusive value="-400.0"/>
            <maxExclusive value="400.0"/>
        </restriction>
    </simpleType>
    <simpleType name="STRotation">
        <annotation>
            <documentation>
                -1 = uninitialized
                0 = Angle Relative to Object
                1 = Absolulte Angle
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="-1"/>
            <maxInclusive value="1"/>
        </restriction>
    </simpleType>
    <simpleType name="STSlant">
        <annotation>
            <documentation>Sets valid range for character slant (AutoCAD-specific)</documentation>
        </annotation>
        <restriction base="double">
            <minInclusive value="-90.0"/>
            <maxInclusive value="90.0"/>
        </restriction>
    </simpleType>
    <simpleType name="STOffsets">
        <annotation>
            <documentation>
                0 = Offset After Rotation
                1 = Offset Before Rotation
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="1"/>
        </restriction>
    </simpleType>
    <simpleType name="STPrecision">
        <annotation>
            <documentation>Value specifies number of decimals (0 to 7)</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="7"/>
        </restriction>
    </simpleType>
    <simpleType name="STLimitedPrecision">
        <annotation>
            <documentation>Value specifies number of decimals (0 to 5)</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="5"/>
        </restriction>
    </simpleType>
    <simpleType name="STExpandedPrecision">
        <annotation>
            <documentation>Value specifies number of decimals (0 to 12)</documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="12"/>
        </restriction>
    </simpleType>
    <simpleType name="STSystemPreferencesStationFormat">
        <annotation>
            <documentation>
                0 = ssss.ss
                2 = ss+ss.ss
                3 = s+sss.ss
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="2"/>
            <enumeration value="3"/>
        </restriction>
    </simpleType>
    <simpleType name="STStationFormat">
        <annotation>
            <documentation>
                0 = None
                1 = ssss.ss
                2 = ss+ss.ss
                3 = s+sss.ss
                4 = [sss]+ss.ss
                5 = sss+[ss.ss]
                6 = sss[+ss.ss]
                7 = ss[s]+ss.ss
                8 = [ss]+sss.ss
                9 = ss+[sss.ss]
                10 = ss[+sss.ss]
                11 = s[s]+sss.ss
                12 = [ss,s]+ss.ss
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="12"/>
        </restriction>
    </simpleType>
    <simpleType name="STDirectionFormat">
        <annotation>
            <documentation>
                0 = ddd^mm'ss.ss"
                1 = ddd.ddd
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="1"/>
        </restriction>
    </simpleType>
    <simpleType name="STSlopeFormat">
        <annotation>
            <documentation>
                0 = 0.50
                1 = 50%
                2 = 0.5:1
                3 = 0.5':1'
                4 = 6":1'
                5 = 12/2":1'
                6 = 24/4":1'
                7 = 48/8":1'
                8 = 96/16":1'
                9 = 1:2.0
                10 = 500%o
                11 = 2.0:1
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="11"/>
        </restriction>
    </simpleType>
    <simpleType name="STSlopeLimitedBaseFormat">
        <annotation>
            <documentation>
                0 = 0.50
                1 = 50%
                2 = 0.5:1
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="2"/>
        </restriction>
    </simpleType>
    <simpleType name="STRadiusFormat">
        <annotation>
            <documentation>
                0 = Radius
                1 = DOC
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="1"/>
        </restriction>
    </simpleType>
    <simpleType name="STSurfaceFeatureType">
        <annotation>
            <documentation>
                1 = Random
                2 = Breakline
                4 = Interior
                8 = Exterior
                16 = Contour
                32 = Inferred
            </documentation>
        </annotation>
        <restriction base="unsignedLong">
            <enumeration value="1"/>
            <enumeration value="2"/>
            <enumeration value="4"/>
            <enumeration value="8"/>
            <enumeration value="16"/>
            <enumeration value="32"/>
        </restriction>
    </simpleType>
    <simpleType name="STSurfaceFeatureTypeList">
        <annotation>
            <documentation>
                0 = Random
                1 = Breakline
                2 = Contour
                3 = Interior
                4 = Exterior
            </documentation>
        </annotation>
        <restriction base="unsignedLong">
            <enumeration value="0"/>
            <enumeration value="1"/>
            <enumeration value="2"/>
            <enumeration value="3"/>
            <enumeration value="4"/>
        </restriction>
    </simpleType>
    <simpleType name="STSurfaceFeatureBaseTypeList">
        <annotation>
            <documentation>
                0 = Random
                1 = Breakline
                2 = Contour
                3 = Interior
                4 = Exterior
            </documentation>
        </annotation>
        <restriction base="unsignedLong">
            <enumeration value="0"/>
            <enumeration value="1"/>
            <enumeration value="2"/>
            <enumeration value="3"/>
            <enumeration value="4"/>
        </restriction>
    </simpleType>
    <simpleType name="STSurfaceLimitedFeatureType">
        <annotation>
            <documentation>
                0 = Random
                1 = Breakline
            </documentation>
        </annotation>
        <restriction base="unsignedLong">
            <enumeration value="0"/>
            <enumeration value="1"/>
        </restriction>
    </simpleType>
    <simpleType name="STPenOrder">
        <annotation>
            <documentation>
                0 = One then Zeros
                1 = Zero then Ones
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="1"/>
        </restriction>
    </simpleType>
    <simpleType name="STOrientation1">
        <annotation>
            <documentation>
                0 = Automatic
                512 = North
                1024 = East
                2048 = West
                4096 = South
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="512"/>
            <enumeration value="1024"/>
            <enumeration value="2048"/>
            <enumeration value="4096"/>
        </restriction>
    </simpleType>
    <simpleType name="STOrientation2">
        <annotation>
            <documentation>
                0 = North
                1 = South
                2 = East
                3 = West
                4 = Automatic
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="1"/>
            <enumeration value="2"/>
            <enumeration value="3"/>
            <enumeration value="4"/>
        </restriction>
    </simpleType>
    <simpleType name="STOrientation4">
        <annotation>
            <documentation>
                0 = Up Station
                1 = Down Station
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="1"/>
        </restriction>
    </simpleType>
    <simpleType name="STLocationAlong">
        <annotation>
            <documentation>
                0 = Midpoint
                1 = Start
                2 = End
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="2"/>
        </restriction>
    </simpleType>
    <simpleType name="STLocationNear">
        <annotation>
            <documentation>
                0 = Left
                1 = Center
                2 = Right
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="2"/>
        </restriction>
    </simpleType>
    <simpleType name="STVolumeLocation">
        <annotation>
            <documentation>
                0 = Top Left
                1 = Top Center
                2 = Top Right
                3 = Middle Left
                4 = Middle Center
                5 = Middle Right
                6 = Bottom Left
                7 = Bottom Center
                8 = Bottom Right
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="1"/>
            <enumeration value="2"/>
            <enumeration value="3"/>
            <enumeration value="6"/>
            <enumeration value="7"/>
            <enumeration value="8"/>
        </restriction>
    </simpleType>
    <simpleType name="STProfileLocation">
        <annotation>
            <documentation>
                Text Top Position
                16 = Up
                32 = Down
                64 = Left
                128 = Right
                Text location with regards to Tick
                256 = Normal
                512 = Above
                1024 = Above Left
                2048 = Above Right
                Horizontal Angle Mode
                4096 = inner
            </documentation>
        </annotation>
        <restriction base="integer">
            <minInclusive value="0"/>
            <maxInclusive value="6272"/>
        </restriction>
    </simpleType>
    <simpleType name="STPointLeaderPosition">
        <annotation>
            <documentation>
                0 = uninitialized
                4 = Concave
                8 = Convex
                16 = Above
                32 = Below
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="4"/>
            <enumeration value="8"/>
            <enumeration value="16"/>
            <enumeration value="32"/>
        </restriction>
    </simpleType>
    <simpleType name="STCurveLeaderPosition">
        <annotation>
            <documentation>
                0 = uninitialized
                16777216 = Inside
                33554432 = Outside
                67108864 = Above
                134217728 = Below
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="16777216"/>
            <enumeration value="33554432"/>
            <enumeration value="67108864"/>
            <enumeration value="134217728"/>
        </restriction>
    </simpleType>
    <simpleType name="STTangentLeaderPosition">
        <annotation>
            <documentation>
                0 = uninitialized
                16 = Midpoint
                32 = Start
                64 = End
                128 = Start and End
            </documentation>
        </annotation>
        <restriction base="integer">
            <enumeration value="0"/>
            <enumeration value="16"/>
            <enumeration value="32"/>
            <enumeration value="64"/>
            <enumeration value="128"/>
        </restriction>
    </simpleType>
    <!-- complex type declarations -->
    <complexType name="CTBaseLineSymbology" mixed="true">
        <annotation>
            <documentation>Contains base line symbology settings</documentation>
        </annotation>
        <attribute name="LayerName" type="ini:STString1023" use="required"/>
        <attribute name="ColorValue" type="ini:STExtendedColorValue" use="required"/>
        <attribute name="Weight" type="ini:STWeight" use="required"/>
        <attribute name="LineTypeName" type="ini:STString63" use="required"/>
        <attribute name="ColorByLayer" type="boolean" use="required"/>
        <attribute name="LineTypeByLayer" type="boolean" use="required"/>
        <attribute name="StyleScale" type="double" use="required"/>
        <attribute name="UseScale" type="boolean" use="required"/>
        <attribute name="Filled" type="boolean" use="required"/>
    </complexType>
    <complexType name="CTBaseTextSymbology" mixed="true">
        <annotation>
            <documentation>Contains base text symbology settings</documentation>
        </annotation>
        <attribute name="TextStyleName" type="ini:STString127" use="optional"/>
        <attribute name="LayerName" type="ini:STString1023" use="required"/>
        <attribute name="ColorValue" type="ini:STExtendedColorValue" use="required"/>
        <attribute name="Weight" type="ini:STWeight" use="required"/>
        <attribute name="TextHeight" type="double" use="required"/>
        <attribute name="TextWidth" type="double" use="required"/>
        <attribute name="LineSpacing" type="double" use="required"/>
        <attribute name="FontStyleName" type="ini:STString1023" use="required"/>
        <attribute name="ColorByLayer" type="boolean" use="required"/>
        <attribute name="Justification" type="ini:STJustification" use="required"/>
    </complexType>
    <complexType name="CTExtendedTextSymbology" mixed="true">
        <annotation>
            <documentation>Contains extended text symbology settings</documentation>
        </annotation>
        <attribute name="Angle" type="ini:STAngle" use="required"/>
        <attribute name="HorizontalOffset" type="double" use="required"/>
        <attribute name="VerticalOffset" type="double" use="required"/>
        <attribute name="ViewIndependent" type="boolean" use="required"/>
        <attribute name="Rotation" type="ini:STRotation" use="required"/>
        <attribute name="Offsets" type="ini:STOffsets" use="required"/>
        <attribute name="LineLength" type="integer" use="required"/>
        <attribute name="PaperUnits" type="integer" use="required"/>
        <attribute name="Slant" type="ini:STSlant" use="required"/>
        <attribute name="CharacterSpacing" type="double" use="required"/>
        <attribute name="MultiLineJustification" type="ini:STJustification" use="required"/>
    </complexType>
    <complexType name="CTSurveyTextSymbology" mixed="true">
        <annotation>
            <documentation>Contains Survey-specific text symbology settings</documentation>
        </annotation>
        <attribute name="JustifyAtDecimal" type="boolean" use="required"/>
        <attribute name="Precision" type="integer" use="required"/>
        <attribute name="ViewTextHeight" type="double" use="required"/>
        <attribute name="ViewTextWidth" type="double" use="required"/>
        <attribute name="ViewHorizontalOffset" type="double" use="required"/>
        <attribute name="ViewVerticalOffset" type="double" use="required"/>
        <attribute name="ViewLineSpacing" type="double" use="required"/>
    </complexType>
    <complexType name="CTBasePointSymbology" mixed="true">
        <annotation>
            <documentation>Contains base point symbology settings</documentation>
        </annotation>
        <attribute name="SymbolLayerName" type="ini:STString1023" use="required"/>
        <attribute name="CellLayerName" type="ini:STString1023" use="required"/>
        <attribute name="Name" type="ini:STString511" use="required"/>
        <attribute name="XScale" type="double" use="required"/>
        <attribute name="YScale" type="double" use="required"/>
        <attribute name="ZScale" type="double" use="required"/>
        <attribute name="ColorValue" type="ini:STExtendedColorValue" use="required"/>
        <attribute name="Weight" type="ini:STWeight" use="required"/>
        <attribute name="FontStyleName" type="ini:STString1023" use="required"/>
        <attribute name="TextHeight" type="double" use="required"/>
        <attribute name="TextWidth" type="double" use="required"/>
        <attribute name="LineTypeName" type="ini:STString63" use="required"/>
        <attribute name="ColorByLayer" type="boolean" use="required"/>
        <attribute name="Character" type="ini:STString1" use="required"/>
        <attribute name="DisplayAs" type="ini:STPointDisplayType" use="required"/>
        <attribute name="Justification" type="ini:STJustification" use="required"/>
        <attribute name="PaperUnits" type="integer" use="required"/>
        <attribute name="Slant" type="ini:STSlant" use="required"/>
        <attribute name="Offsets" type="ini:STOffsets" use="required"/>
        <attribute name="DisplaySymbol" type="boolean" use="required"/>
        <attribute name="DisplayCellBlock" type="boolean" use="required"/>
    </complexType>
    <complexType name="CTExtendedPointSymbology" mixed="true">
        <annotation>
            <documentation>Contains extended point symbology settings</documentation>
        </annotation>
        <attribute name="SymbolRotation" type="ini:STRotation" use="required"/>
        <attribute name="SymbolAngle" type="ini:STAngle" use="required"/>
        <attribute name="CellRotation" type="ini:STRotation" use="required"/>
        <attribute name="CellAngle" type="ini:STAngle" use="required"/>
    </complexType>
    <complexType name="CTAnnotationPlacement" mixed="true">
        <annotation>
            <documentation>Contains text placement settings</documentation>
        </annotation>
        <attribute name="Display" type="boolean" use="optional"/>
        <attribute name="Prefix" type="ini:STString31" use="optional"/>
        <attribute name="Suffix" type="ini:STString31" use="optional"/>
        <attribute name="DualDimensionPrecision" type="ini:STPrecision" use="optional"/>
        <attribute name="AttributeName" type="ini:STString31" use="optional"/>
        <attributeGroup ref="ini:AGColumn"/>
        <attribute name="Row" use="optional">
            <simpleType>
                <restriction base="integer">
                    <minInclusive value="-100"/>
                    <maxInclusive value="100"/>
                </restriction>
            </simpleType>
        </attribute>
        <attributeGroup ref="ini:AGPrecision"/>
        <attributeGroup ref="ini:AGFormat"/>
        <attributeGroup ref="ini:AGOrientation"/>
        <attributeGroup ref="ini:AGLocation"/>
    </complexType>
    <complexType name="CTGeometryPointAnnotation" mixed="true">
        <annotation>
            <documentation>Contains geometry point annotation settings</documentation>
        </annotation>
        <attribute name="Abbreviation" type="ini:STString31" use="required"/>
        <attribute name="SymbolName" type="ini:STString31" use="optional"/>
        <attribute name="CellName" type="ini:STString31" use="optional"/>
    </complexType>
    <complexType name="CTPlanarizeOption" mixed="true">
        <annotation>
            <documentation>Contains setting for planarize option</documentation>
        </annotation>
        <attribute name="Planarize" type="boolean" use="required"/>
        <attribute name="PlanarElevation" type="double" use="required"/>
        <attribute name="Scale" type="double" use="optional"/>
    </complexType>
    <complexType name="CTScalingOption" mixed="true">
        <annotation>
            <documentation>Contains setting for surface scaling option</documentation>
        </annotation>
        <attribute name="Planarize" type="boolean" use="required"/>
        <attribute name="PlanarElevation" type="double" use="required"/>
        <attribute name="ScaleRelative" type="boolean" use="required"/>
        <attribute name="FixedElevation" type="double" use="required"/>
        <attribute name="Scale" type="double" use="required"/>
    </complexType>
    <complexType name="CTNewFeature" mixed="true">
        <annotation>
            <documentation>Contains settings for creating or modifying features</documentation>
        </annotation>
        <attribute name="FeatureName" type="ini:STString31" use="optional"/>
        <attribute name="FeatureStyle" type="ini:STString31" use="optional"/>
        <attributeGroup ref="ini:AGSurfaceFeatureType"/>
        <attribute name="DensityInterval" use="optional">
            <simpleType>
                <restriction base="double">
                    <minInclusive value="0.0"/>
                </restriction>
            </simpleType>
        </attribute>
        <attribute name="DuplicateNames" use="optional">
            <annotation>
                <documentation>
                    0 = Append
                    1 = Replace
                    2 = Rename
                    3 = Modify
                </documentation>
            </annotation>
            <simpleType>
                <restriction base="integer">
                    <minInclusive value="0"/>
                    <maxInclusive value="3"/>
                </restriction>
            </simpleType>
        </attribute>
        <attribute name="ExcludeFromTriangulation" type="boolean" use="optional"/>
    </complexType>
    <complexType name="CTSurveyFeatureFilterRule" mixed="true">
        <annotation>
            <documentation>Contains rules for survey feature filters</documentation>
        </annotation>
        <attribute name="Name" type="ini:STString31" use="required"/>
    </complexType>
    <complexType name="CTFeatureFilterRule" mixed="true">
        <annotation>
            <documentation>Contains rules for feature filters</documentation>
        </annotation>
        <attribute name="Mode" type="integer" use="required"/>
        <attribute name="Attribute" type="integer" use="required"/>
        <attribute name="Value" type="integer" use="required"/>
        <attribute name="String" type="ini:STString63" use="optional"/>
    </complexType>
    <complexType name="CTLeaderLine" mixed="true">
        <annotation>
            <documentation>Contains settings for leader lines</documentation>
        </annotation>
        <attribute name="DisplayPartOne" type="boolean" use="optional"/>
        <attribute name="PartOneLength" type="double" use="optional"/>
        <attribute name="PartOneAngle" type="ini:STAngle" use="optional"/>
        <attribute name="DisplayPartTwo" type="boolean" use="optional"/>
        <attribute name="PartTwoLength" type="double" use="optional"/>
        <attribute name="PartTwoAngle" type="ini:STAngle" use="optional"/>
        <attributeGroup ref="ini:AGLeaderPosition"/>
        <attribute name="Offset" type="double" use="optional"/>
        <attribute name="StartLeaderOffset" type="double" use="optional"/>
        <attribute name="StopLeaderOffset" type="double" use="optional"/>
        <attribute name="StartBendOffset" type="double" use="optional"/>
        <attribute name="StopBendOffset" type="double" use="optional"/>
    </complexType>
    <complexType name="CTDisplayTicks" mixed="true">
        <annotation>
            <documentation>Contains settings for tick display</documentation>
        </annotation>
        <attribute name="Spacing" type="double" use="optional"/>
        <attribute name="MinorTicksPerMajor" type="integer" use="optional"/>
        <attribute name="Length" type="double" use="optional"/>
        <attribute name="LeftOrInsideOffset" type="double" use="optional"/>
        <attribute name="RightOrOutsideOffset" type="double" use="optional"/>
    </complexType>
    <complexType name="CTAxis" mixed="true">
        <annotation>
