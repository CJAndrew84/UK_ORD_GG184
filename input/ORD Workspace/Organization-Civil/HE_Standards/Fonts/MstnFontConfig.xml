<?xml version="1.0" encoding="utf-8"?>
<FontConfig>
    <LanguageSettings>
        <!--
        <LanguageSetting> nodes specify settings for individual locales.
            Name (Attribute)        (Required) String identifying the locale that the node defines. This corresponds to the value of MS_RTCONFIG, or the primary locale name of your active code page.
                                    Must be one of English|Japanese|SimpChinese|Korean|TradChinese|Vietnamese|Arabic|Hebrew|Thai
            <DefaultRscFont>        (Required) Name of the default RSC font. This is used as the fallback font (in case of missing fonts), as well as in some APIs.
                                    This can be a comma-separated list. As the list is processed, the first font that can be resolved is used (i.e. others are ignored).
            <DefaultTrueTypeFont>   (Required) Name of the default TrueType font. This is used as the fallback font (in case of missing fonts), as well as in some APIs.
                                    This can be a comma-separated list. As the list is processed, the first font that can be resolved is used (i.e. others are ignored).
            <DefaultShxFont>        (Required) Name of the default SHX font. This is used as the fallback font (in case of missing fonts), as well as in some APIs.
                                    This can be a comma-separated list. As the list is processed, the first font that can be resolved is used (i.e. others are ignored).
            <DefaultShxBigFont>     (Required) Name of the default SHX big font. This is used as the fallback font (in case of missing fonts), as well as in some APIs.
                                    This can be a comma-separated list. As the list is processed, the first font that can be resolved is used (i.e. others are ignored).
            <FontLinking>           (Optional; default=Disabled) Font linking is an advanced way of performing display-time font substitution on a per-glyph basis.
                                    Font linking incurs a performance penalty during display, but is desirable in some languages when commonly used fonts don't contain required glyphs (notably Chinese, Japanese, and Korean).
                                    Must be one of Enabled|Disabled
            <GlyphShaping>          (Optional; default=Enabled) Allows you to prevent glyph shaping. Shaping can affect glyph substitution in some languages (notably Chinese, Japanese, and Korean), causung missing glyphs.
                                    Must be one of Enabled|Disabled
        -->

        <LanguageSetting Name="English">
            <DefaultRscFont>Standard</DefaultRscFont>
            <DefaultTrueTypeFont>Arial</DefaultTrueTypeFont>
            <DefaultShxFont>simplex,msdefault</DefaultShxFont>
            <DefaultShxBigFont>bigfont,kanjibig</DefaultShxBigFont>
            <GlyphShaping>Disabled</GlyphShaping>
        </LanguageSetting>

        <LanguageSetting Name="Japanese">
            <DefaultRscFont>Kanji</DefaultRscFont>
            <DefaultTrueTypeFont>MS Gothic</DefaultTrueTypeFont>
            <DefaultShxFont>kanji</DefaultShxFont>
            <DefaultShxBigFont>bigfont,kanjibig</DefaultShxBigFont>
            <FontLinking>Enabled</FontLinking>
            <GlyphShaping>Disabled</GlyphShaping>
        </LanguageSetting>

        <LanguageSetting Name="SimpChinese">
            <DefaultRscFont>Standard</DefaultRscFont>
            <DefaultTrueTypeFont>SimSun</DefaultTrueTypeFont>
            <DefaultShxFont>simplex,msdefault</DefaultShxFont>
            <DefaultShxBigFont>gbcbig</DefaultShxBigFont>
            <FontLinking>Enabled</FontLinking>
            <GlyphShaping>Disabled</GlyphShaping>
        </LanguageSetting>

        <LanguageSetting Name="TradChinese">
            <DefaultRscFont>chinese_traditional</DefaultRscFont>
            <DefaultTrueTypeFont>MingLiU</DefaultTrueTypeFont>
            <DefaultShxFont>tradch</DefaultShxFont>
            <DefaultShxBigFont>chineset</DefaultShxBigFont>
            <FontLinking>Enabled</FontLinking>
            <GlyphShaping>Disabled</GlyphShaping>
        </LanguageSetting>

        <LanguageSetting Name="Korean">
            <DefaultRscFont>Gothic_single</DefaultRscFont>
            <DefaultTrueTypeFont>GulimChe</DefaultTrueTypeFont>
            <DefaultShxFont>kor</DefaultShxFont>
            <DefaultShxBigFont>whgtxt,korbig</DefaultShxBigFont>
            <FontLinking>Enabled</FontLinking>
            <GlyphShaping>Disabled</GlyphShaping>
        </LanguageSetting>

        <LanguageSetting Name="Arabic">
            <DefaultRscFont>Standard</DefaultRscFont>
            <DefaultTrueTypeFont>Arial</DefaultTrueTypeFont>
            <DefaultShxFont>simplex,msdefault</DefaultShxFont>
            <DefaultShxBigFont>bigfont,kanjibig</DefaultShxBigFont>
        </LanguageSetting>

        <LanguageSetting Name="Hebrew">
            <DefaultRscFont>Standard</DefaultRscFont>
            <DefaultTrueTypeFont>Arial</DefaultTrueTypeFont>
            <DefaultShxFont>simplex,msdefault</DefaultShxFont>
            <DefaultShxBigFont>bigfont,kanjibig</DefaultShxBigFont>
        </LanguageSetting>

        <LanguageSetting Name="Thai">
            <DefaultRscFont>Standard</DefaultRscFont>
            <DefaultTrueTypeFont>Arial</DefaultTrueTypeFont>
            <DefaultShxFont>simplex,msdefault</DefaultShxFont>
            <DefaultShxBigFont>bigfont,kanjibig</DefaultShxBigFont>
        </LanguageSetting>

        <LanguageSetting Name="Vietnamese">
            <DefaultRscFont>Standard</DefaultRscFont>
            <DefaultTrueTypeFont>Arial</DefaultTrueTypeFont>
            <DefaultShxFont>simplex,msdefault</DefaultShxFont>
            <DefaultShxBigFont>bigfont,kanjibig</DefaultShxBigFont>
        </LanguageSetting>

    </LanguageSettings>

    <Fonts>
        <!--
        <RscFontInfo> nodes specify settings for individual RSC fonts. This is metadata that is required for correct character mapping and operation, but is not available in the RSC font definition.
            <Name>              (Required) Comma-separate list of fonts names to which this node corresponds to.
            <CodePage>          (Required) The code page associated with these fonts. See http://msdn.microsoft.com/en-us/goglobal/bb964654.aspx.
                                If an RSC font is not specifically configured in this file, it is assumed to use your ACP (Active Code Page).
                                At the time of this writing, should be one of:
                                    874     (Thai)
                                    932     (Japanese Shift-JIS)
                                    936     (Simplified Chinese GBK)
                                    949     (Korean)
                                    950     (Traditional Chinese Big5)
                                    1250    (Central Europe)
                                    1251    (Cyrillic)
                                    1252    (Latin I)
                                    1253    (Greek)
                                    1254    (Turkish)
                                    1255    (Hebrew)
                                    1256    (Arabic)
                                    1257    (Baltic)
                                    1258    (Vietnam)
            <Hidden>            (Optional; default=False) Hides these fonts in the UI pickers. The font can still, however, be used, and may appear in UI pickers if the active style uses it.
                                Must be one of True|False.
            <DegreeChar>        (Optional; default=94) The code point / glyph index of the degree glyph. This number must be in base-10 (NOT hexadecimal).
            <DiameterChar>      (Optional; default=216) The code point / glyph index of the diameter glyph. This number must be in base-10 (NOT hexadecimal).
            <PlusMinusChar>     (Optional; default=200) The code point / glyph index of the plus/minus glyph. This number must be in base-10 (NOT hexadecimal).
            <NamedSymbols>      (Optional) One or more <NamedSymbol> nodes (see below) that allow you to define named code points for custom glyphs in fonts.
            <CreateShxUnifont>  (Optional; default=True) When converting to DWG, controls whether a Unifont (vs. old locale-encoded) is created when converting RSC fonts.
                                The only time this should be False is for symbol fonts, which re-purpose code points to be custom symbols, and thus Unicode re-mapping is useless.
                                Must be one of True|False.
            
            <NamedSymbol>
                <Key>           (Required) A non-localized string that identifies this symbol across cultures.
                                The following are reserved for internal use: "Degree", "Diameter", "PlusMinus".
                <DisplayName>   (Required*) The name of the symbol; this will be displayed in pickers.
                                This is required for all user-defined symbols; Bentley-delivered symbols rely on a hard-coded lookup based on their <Key> for localization purposes.
                <CodePoint>     (Required) The code point / glyph index of the symbol. This number must be in base-10 (NOT hexadecimal).
        -->

        <RscFontInfo>
