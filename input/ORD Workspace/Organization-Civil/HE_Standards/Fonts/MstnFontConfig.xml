        <!--
        <ShxFontInfo> nodes specify settings for individual SHX fonts. This is metadata that is required for correct character mapping and operation, but is not available in the SHX font definition.
            <Name>              (Required) Comma-separate list of fonts names to which this node corresponds to.
            <CodePage>          (Required for non-Unifont) The code page associated with these fonts. See http://msdn.microsoft.com/en-us/goglobal/bb964654.aspx.
                                This only applies to non-Unifont SHX fonts (which assume 1200). Nodes for Unifonts can omit this.
                                If a non-Unifont SHX font is not specifically configured in this file, it is assumed to use your ACP (Active Code Page).
                                At the time of this writing, should be one of:
                                    874     (Thai)
                                    932     (Japanese Shift-JIS)
                                    936     (Simplified Chinese GBK)
                                    949     (Korean)
                                    950     (Traditional Chinese Big5)
                                    1250    (Central Europe)
                                    1251    (Cyrillic)
                                    1252    (Latin I)
                                    1253    (Greek)
                                    1254    (Turkish)
                                    1255    (Hebrew)
                                    1256    (Arabic)
                                    1257    (Baltic)
                                    1258    (Vietnam)
            <Hidden>            (Optional; default=False) Hides these fonts in the UI pickers. The font can still, however, be used, and may appear in UI pickers if the active style uses it.
                                Must be one of True|False.
            <DegreeChar>        (Optional) The code point / glyph index of the degree glyph. This number must be in base-10 (NOT hexadecimal).
                                Default (shape font)    = 127
                                Default (locale font)   = 256
                                Default (big font)      = locale of Unicode 176
                                Default (Unifont)       = 176
            <DiameterChar>      (Optional) The code point / glyph index of the diameter glyph. This number must be in base-10 (NOT hexadecimal).
                                Default (shape font)    = 129
                                Default (locale font)   = 258
                                Default (big font)      = locale of Unicode 8709
                                Default (Unifont)       = 8709
            <PlusMinusChar>     (Optional) The code point / glyph index of the plus/minus glyph. This number must be in base-10 (NOT hexadecimal).
                                Default (shape font)    = 128
                                Default (locale font)   = 257
                                Default (big font)      = locale of Unicode 177
                                Default (Unifont)       = 177
            <NamedSymbols>      (Optional) One or more <NamedSymbol> nodes (see below) that allow you to define named code points for custom glyphs in fonts.
            
            <NamedSymbol>
                <Key>           (Required) A non-localized string that identifies this symbol across cultures.
                                The following are reserved for internal use: "Degree", "Diameter", "PlusMinus".
                <DisplayName>   (Required*) The name of the symbol; this will be displayed in pickers.
                                This is required for all user-defined symbols; Bentley-delivered symbols rely on a hard-coded lookup based on their <Key> for localization purposes.
                <CodePoint>     (Required) The code point / glyph index of the symbol. This number must be in base-10 (NOT hexadecimal).
        -->

        <!-- Japanese SHX fonts. -->
        <ShxFontInfo>
            <Name>kanji,kanjibig,bigfont,extfont,extfont2,@extfont2,spec_bar,spec_sl,special</Name>
            <CodePage>932</CodePage>
            <Hidden>False</Hidden>
        </ShxFontInfo>

        <!-- Simplified Chinese SHX fonts. -->
        <ShxFontInfo>
            <Name>gbcbig,tssdchn,hzjd,hztxt</Name>
            <CodePage>936</CodePage>
            <Hidden>False</Hidden>
        </ShxFontInfo>

        <!-- Traditional Chinese SHX fonts. -->
        <ShxFontInfo>
            <Name>tradch,chineset,tradchbig,chinese_traditionalbig</Name>
            <CodePage>950</CodePage>
            <Hidden>False</Hidden>
        </ShxFontInfo>

        <!-- Korean SHX fonts. -->
        <ShxFontInfo>
            <Name>whgdtxt,whgtxt,whtgtxt,whtmtxt,kor,korbig,myongjo_outlinebig,myongjo_fillbig,gothic_outlinebig,gothic_fillbig,myongjo_singlebig,gothic_singlebig</Name>
            <CodePage>949</CodePage>
            <Hidden>False</Hidden>
        </ShxFontInfo>

        <!-- Cyrillic SHX fonts. -->
        <ShxFontInfo>
            <Name>russ</Name>
