            <sequence>
                <element ref="inr:Start" minOccurs="0"/>
                <element ref="inr:PI" minOccurs="0"/>
                <element ref="inr:Center" minOccurs="0"/>
                <element ref="inr:End" minOccurs="0"/>
                <element ref="inr:StationEquation" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
            <attribute name="style" type="string" use="optional"/>
            <attribute name="radius" type="double" use="required"/>
            <attribute name="delta" type="inr:STAngle" use="required"/>
            <attribute name="rotationDirection" type="inr:STRotationDirection" use="required"/>
            <attribute name="degreeOfCurve" type="inr:STAngle" use="optional"/>
            <attribute name="length" type="double" use="required"/>
            <attribute name="tangentLength" type="double" use="optional"/>
            <attribute name="chord" type="double" use="optional"/>
            <attribute name="middleOrdinate" type="double" use="optional"/>
            <attribute name="externalDistance" type="double" use="optional"/>
            <attribute name="tangentialDirectionStart" type="inr:STDirection" use="optional"/>
            <attribute name="radialDirectionStart" type="inr:STDirection" use="optional"/>
            <attribute name="chordDirection" type="inr:STDirection" use="optional"/>
            <attribute name="radialDirectionEnd" type="inr:STDirection" use="optional"/>
            <attribute name="tangentialDirectionEnd" type="inr:STDirection" use="optional"/>
            <attribute name="deflectionAngle" type="inr:STAngle" use="optional"/>
            <attribute name="elementNumber" type="integer" use="optional"/>
            <attribute name="name" type="string" use="optional"/>
            <attribute name="superelevation" type="double" use="optional"/>
