    <element name="HorizontalRegressionPoints">
        <annotation>
            <documentation>A collection of horizontal regression points</documentation>
        </annotation>
        <complexType>
            <sequence>
                <element ref="inr:HorizontalRegressionPoint" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
        </complexType>
