                <annotation>
                    <documentation>
                         0 = Roadway
                         1 = Cant
                    </documentation>
                </annotation>
                <simpleType>
                    <restriction base="integer">
                        <minInclusive value="0"/>
                        <maxInclusive value="1"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="designSpeed" use="optional">
                <simpleType>
                    <restriction base="double">
                        <minExclusive value="0.0"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="superelevationCrown" use="optional">
                <annotation>
                    <documentation>Normal Crown or Reverse Crown.  Exists only if the superelevation is one of these types.</documentation>
                </annotation>
