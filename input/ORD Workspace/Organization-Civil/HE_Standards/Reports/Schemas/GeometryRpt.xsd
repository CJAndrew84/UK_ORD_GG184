                <element ref="inr:PVI"/>
                <element ref="inr:VerticalEnd"/>
                <element ref="inr:TurningPoint" minOccurs="0"/>
                <element ref="inr:StationEquation" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
            <attribute name="style" type="string" use="optional"/>
            <attribute name="startRadius" type="double" use="required"/>
            <attribute name="endRadius" type="double" use="required"/>
            <attribute name="length" type="double" use="required"/>
            <attribute name="thetaAngle" type="inr:STAngle" use="optional"/>
            <attribute name="aConstant" type="double" use="optional"/>
            <attribute name="longTangent" type="double" use="optional"/>
            <attribute name="shortTangent" type="double" use="optional"/>
            <attribute name="longChord" type="double" use="optional"/>
            <attribute name="xs" type="double" use="optional"/>
            <attribute name="ks" type="double" use="optional"/>
            <attribute name="ys" type="double" use="optional"/>
            <attribute name="p" type="double" use="optional"/>
            <attribute name="startGrade" type="double" use="optional"/>
            <attribute name="endGrade" type="double" use="optional"/>
        </complexType>
    </element>
    <element name="VerticalCircle">
        <annotation>
            <documentation>Vertical circular element</documentation>
        </annotation>
        <complexType>
            <sequence>
                <element ref="inr:VerticalStart"/>
                <element ref="inr:PVI"/>
                <element ref="inr:VerticalCenter"/>
