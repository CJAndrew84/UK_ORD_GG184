                    <restriction base="string">
                        <enumeration value="NC"/>
                        <enumeration value="RC"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="appliedCant" use="optional">
                <simpleType>
                    <restriction base="double">
                        <minExclusive value="0.0"/>
                    </restriction>
