            <attribute name="radius" type="double" use="required"/>
            <attribute name="startGrade" type="double" use="optional"/>
            <attribute name="endGrade" type="double" use="optional"/>
            <attribute name="length" type="double" use="optional"/>
            <attribute name="midOrdinate" type="double" use="optional"/>
