            <attribute name="endRadius" type="double" use="required"/>
            <attribute name="length" type="double" use="required"/>
            <attribute name="thetaAngle" type="inr:STAngle" use="optional"/>
            <attribute name="rotationDirection" type="inr:STRotationDirection" use="required"/>
            <attribute name="aConstant" type="double" use="optional"/>
            <attribute name="longTangent" type="double" use="optional"/>
            <attribute name="shortTangent" type="double" use="optional"/>
            <attribute name="longChord" type="double" use="optional"/>
            <attribute name="xs" type="double" use="optional"/>
            <attribute name="ys" type="double" use="optional"/>
            <attribute name="p" type="double" use="optional"/>
            <attribute name="ks" type="double" use="optional"/>
            <attribute name="tangentialDirectionStart" type="inr:STDirection" use="optional"/>
            <attribute name="radialDirectionStart" type="inr:STDirection" use="optional"/>
            <attribute name="chordDirection" type="inr:STDirection" use="optional"/>
            <attribute name="radialDirectionEnd" type="inr:STDirection" use="optional"/>
            <attribute name="tangentialDirectionEnd" type="inr:STDirection" use="optional"/>
            <attribute name="clothoidStartX" type="double" use="optional"/>
            <attribute name="clothoidStartY" type="double" use="optional"/>
            <attribute name="clothoidLength" type="double" use="optional"/>
            <attribute name="clothoidStartDirection" type="inr:STDirection" use="optional"/>
            <attribute name="elementNumber" type="integer" use="optional"/>
            <attribute name="name" type="string" use="optional"/>
