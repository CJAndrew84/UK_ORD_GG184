    <element name="HorizontalEventPoints">
        <annotation>
            <documentation>
                A collection of horizontal normal and computed event points and regression points
            </documentation>
        </annotation>
        <complexType>
            <sequence>
                <element ref="inr:HorizontalNormalEventPoints" minOccurs="0"/>
                <element ref="inr:HorizontalComputedEventPoints" minOccurs="0"/>
