            <sequence>
                <element ref="inr:VerticalStart"/>
                <element ref="inr:PVI"/>
                <element ref="inr:PVCC"/>
                <element ref="inr:VerticalEnd"/>
                <element ref="inr:TurningPoint" minOccurs="0"/>
                <element ref="inr:StationEquation" minOccurs="0" maxOccurs="unbounded"/>
                <element ref="inr:SightDistance" minOccurs="0"/>
            </sequence>
            <attribute name="style" type="string" use="optional"/>
            <attribute name="startVerticalCurveLength" type="double" use="required"/>
            <attribute name="endVerticalCurveLength" type="double" use="required"/>
            <attribute name="midOrdinate" type="double" use="optional"/>
            <attribute name="startGrade" type="double" use="optional"/>
            <attribute name="endGrade" type="double" use="optional"/>
            <attribute name="startRateOfChange" type="double" use="optional"/>
            <attribute name="endRateOfChange" type="double" use="optional"/>
            <attribute name="startKValue" type="double" use="optional"/>
            <attribute name="endKValue" type="double" use="optional"/>
            <attribute name="externalDistance" type="double" use="optional"/>
        </complexType>
    </element>
    <element name="VerticalClothoid">
        <annotation>
            <documentation>Vertical spiral transition element</documentation>
