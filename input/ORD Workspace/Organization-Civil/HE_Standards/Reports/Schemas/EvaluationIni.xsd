			<attribute name="ExtractOffset5Flag" type="integer" use="required"/>
			<attribute name="NumberOfCrossSectionSheets" type="integer" use="required"/>
			<attribute name="DisplayAbsoluteBottomAxis" type="integer" use="required"/>
			<attribute name="DisplayAbsoluteTopAxis" type="integer" use="required"/>
			<attribute name="CustomAlignAtOffset" type="integer" use="optional"/>
			<attribute name="CustomAlignAtOffsetValue" type="double" use="optional"/>
			<attribute name="CustomAlignAtOffsetColumnsPerSheet" type="integer" use="optional"/>
			<attribute name="IncludeSymbolCell" type="integer" use="optional"/>
			<attribute name="SymbolCellLocation" type="integer" use="optional"/>
			<attribute name="SymbolCellVerticalOffset" type="double" use="optional"/>
			<attribute name="SymbolCellHorizontalOffset" type="double" use="optional"/>
			<attribute name="SheetName" type="ini:STString255" use="optional"/>
			<attribute name="TitleBlockDataFile" type="ini:STString255" use="optional"/>
			<attribute name="TitleBlockPWDataFile" type="ini:STString255" use="optional"/>
			<attribute name="IncludeTitleBlockCell" type="integer" use="optional"/>
			<attribute name="TitleBlockCellName" type="ini:STString255" use="optional"/>
			<attribute name="GeneratorSingleSheetEach" type="boolean" use="optional"/>
			<attribute name="GeneratorSheetLocation" type="integer" use="optional"/>
			<attribute name="GeneratorModelType" type="integer" use="optional"/>
			<attribute name="GeneratorModelName" type="ini:STString255" use="optional"/>
			<attribute name="GeneratorSheetFile" type="ini:STString255" use="optional"/>
			<attribute name="GeneratorSeedSheet" type="ini:STString255" use="optional"/>
			<attribute name="GeneratorXLocation" type="double" use="optional"/>
			<attribute name="GeneratorYLocation" type="double" use="optional"/>
			<!--Extras-->
		</complexType>
	</element>
	<element name="CreateCrossSectionCollection">
		<annotation>
			<documentation>Collection of Create Cross Section preferences</documentation>
		</annotation>
		<complexType>
			<sequence>
				<element ref="ini:CreateCrossSection" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
