			<attribute name="DisplayPlanimetricStationText" type="boolean" use="required"/>
			<attribute name="DisplayFeatureBand" type="boolean" use="required"/>
			<attribute name="DisplayStructureBand" type="boolean" use="required"/>
			<attribute name="SheetLayout" type="boolean" use="required"/>
			<attribute name="PlotDirection" use="required">
				<annotation>
					<documentation>
                    0 = Bottom to Top
                    1 = Top to Bottom
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="SheetSize" use="required">
				<annotation>
					<documentation>
                        0 = uninitialized
                        1 = A
                        2 = B
                        4 = C
                        8 = D
                        16 = E
                        32 = A4
                        64 = A3
                        128 = A2
                        256 = A1
                        512 = A0
                        1024 = CUSTOM
                        2048 = Cell/Block
                        5120 = Reference file
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="5120"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="CellName" type="ini:STString1023" use="required"/>
			<attribute name="FileName" type="ini:STString1023" use="required"/>
			<attribute name="PWFileName" type="ini:STString1023" use="required"/>
			<attribute name="CustomSheetWidth" type="double" use="required"/>
			<attribute name="CustomSheetHeight" type="double" use="required"/>
			<attribute name="SheetOrientationMode" use="required">
				<annotation>
					<documentation>
                        0 = Portrait
                        1048576 = Landscape
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1048576"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="SheetScale" type="double" use="required"/>
			<attribute name="SheetHorizontalOffset" type="double" use="required"/>
			<attribute name="SheetVerticalOffset" type="double" use="required"/>
			<attribute name="LeftSheetMargin" type="double" use="required"/>
			<attribute name="RightSheetMargin" type="double" use="required"/>
			<attribute name="BottomSheetMargin" type="double" use="required"/>
			<attribute name="TopSheetMargin" type="double" use="required"/>
			<attribute name="SheetsPerColumn" type="integer" use="required"/>
			<attribute name="SectionsPerColumn" use="required">
				<simpleType>
					<restriction base="integer">
						<minInclusive value="1"/>
						<maxInclusive value="32767"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="HorizontalSpacingMode" use="required">
				<annotation>
					<documentation>
                        0 = Left to Left
                        1 = Right to Left
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="LeftToLeftDistance" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="RightToLeftDistance" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="VerticalSpacingMode" use="required">
				<annotation>
					<documentation>
                        0 = Bottom to Bottom
                        1 = Top to Bottom
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="BottomToBottomDistance" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="TopToBottomDistance" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="TitleText" type="ini:STString31" use="required"/>
