			<attribute name="LowElevation" type="double" use="required"/>
			<attribute name="UseStationLimits" type="boolean" use="required"/>
			<attribute name="ApplyWindowClearance" type="boolean" use="required"/>
			<attribute name="TopClearance" type="double" use="required"/>
			<attribute name="BottomClearance" type="double" use="required"/>
			<attribute name="VerticalExaggeration" use="required">
				<simpleType>
					<restriction base="double">
						<minInclusive value="0.001"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="CutCriticalSectionsAtHorizontalCardinalPoints" type="boolean" use="required"/>
			<attribute name="CutCriticalSectionsAtVerticalCardinalPoints" type="boolean" use="required"/>
