			<attribute name="ItemName" type="ini:STString31" use="required"/>
			<attribute name="CreateWindow" type="boolean" use="optional"/>
			<attribute name="CreateData" type="boolean" use="optional"/>
			<attribute name="LeftOffset" type="double" use="required"/>
			<attribute name="RightOffset" type="double" use="required"/>
			<attribute name="Interval" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="SourceType" use="required">
				<annotation>
					<documentation>
                        0 = Alignment
                        1 = Graphics
                        2 = Multipoint
                        3 = Ascii File
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="3"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="SingleStation" type="double" use="required"/>
			<attribute name="DisplaySurface1" type="boolean" use="required"/>
			<attribute name="DisplaySurface2" type="boolean" use="required"/>
			<attribute name="DisplaySurface3" type="boolean" use="required"/>
			<attribute name="DisplaySurface4" type="boolean" use="required"/>
			<attribute name="DisplaySurface5" type="boolean" use="required"/>
			<attribute name="DisplaySurface6" type="boolean" use="required"/>
			<attribute name="DisplaySurface7" type="boolean" use="required"/>
			<attribute name="DisplaySurface8" type="boolean" use="required"/>
			<attribute name="DisplaySurface9" type="boolean" use="required"/>
			<attribute name="DisplaySurface10" type="boolean" use="required"/>
			<attribute name="DisplaySurface11" type="boolean" use="required"/>
			<attribute name="DisplaySurface12" type="boolean" use="required"/>
			<attribute name="DisplaySurface13" type="boolean" use="required"/>
			<attribute name="DisplaySurface14" type="boolean" use="required"/>
			<attribute name="DisplaySurface15" type="boolean" use="required"/>
			<attribute name="DisplaySurface16" type="boolean" use="required"/>
			<attribute name="DisplaySurface17" type="boolean" use="required"/>
			<attribute name="DisplaySurface18" type="boolean" use="required"/>
			<attribute name="DisplaySurface19" type="boolean" use="required"/>
			<attribute name="DisplaySurface20" type="boolean" use="required"/>
			<attribute name="DisplaySurface21" type="boolean" use="required"/>
			<attribute name="DisplaySurface22" type="boolean" use="required"/>
			<attribute name="DisplaySurface23" type="boolean" use="required"/>
			<attribute name="DisplaySurface24" type="boolean" use="required"/>
			<attribute name="DisplaySurface25" type="boolean" use="required"/>
			<attribute name="IncludeCrossingFeatures" type="boolean" use="required"/>
			<attribute name="IncludeCrossingFeaturesAdjustRange" type="boolean" use="optional"/>
			<attribute name="IncludeProjectedFeatures" type="boolean" use="required"/>
			<attribute name="FeatureAheadBand" type="double" use="required"/>
			<attribute name="FeatureBackBand" type="double" use="required"/>
			<attribute name="IncludeComponents" type="boolean" use="required"/>
			<attribute name="IncludeCrossingStructures" type="boolean" use="required"/>
			<attribute name="IncludeProjectedStructures" type="boolean" use="required"/>
			<attribute name="StructureAheadBand" type="double" use="required"/>
			<attribute name="StructureBackBand" type="double" use="required"/>
