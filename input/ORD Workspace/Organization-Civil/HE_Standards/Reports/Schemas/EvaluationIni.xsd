			<attribute name="VerticalTitleOffset" type="double" use="required"/>
			<attribute name="DisplayTitleText" type="boolean" use="required"/>
			<attribute name="DisplayTitleBox" type="boolean" use="required"/>
			<attribute name="LegendLineLabel" type="ini:STString31" use="required"/>
			<attribute name="LegendSurfaceLabel" type="ini:STString31" use="required"/>
			<attribute name="LegendScaleLabel" type="ini:STString31" use="required"/>
			<attribute name="DisplayLegendText" type="boolean" use="required"/>
			<attribute name="DisplayLegendBox" type="boolean" use="required"/>
			<attribute name="SheetRangeHorizontalOffset" type="double" use="required"/>
			<attribute name="SheetRangeVerticalOffset" type="double" use="required"/>
			<attribute name="DisplaySheetRangeText" type="boolean" use="required"/>
			<attribute name="DisplaySheetRangeBoxFlag" type="boolean" use="required"/>
			<attribute name="DisplayMajorHorizontalGrid" type="boolean" use="required"/>
			<attribute name="DisplayMinorHorizontalGrid" type="boolean" use="required"/>
			<attribute name="DisplayMajorVerticalGrid" type="boolean" use="required"/>
			<attribute name="DisplayMinorVerticalGrid" type="boolean" use="required"/>
			<attribute name="ClipMajorHorizontalGrid" type="boolean" use="required"/>
			<attribute name="ClipMinorHorizontalGrid" type="boolean" use="required"/>
			<attribute name="ClipMajorVerticalGrid" type="boolean" use="required"/>
			<attribute name="ClipMinorVerticalGrid" type="boolean" use="required"/>
			<attribute name="TunnelNumberOfOvershotMajorGridLines" type="integer" use="optional"/>
			<attribute name="TunnelNumberOfUndercutMajorGridLines" type="integer" use="optional"/>
			<attribute name="TunnelDisplayOptions" use="optional">
				<annotation>
					<documentation>
                        0 = None
                        1 = Tunnel Section
                        2 = Major Grid Lines
                        4 = Minor Grid Lines
                        Values are cummulative
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="7"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="PlotProfileToLeftFlag" type="integer" use="required"/>
			<attribute name="PlotShadeFlag" type="integer" use="required"/>
			<attribute name="ExtractOffset1Flag" type="integer" use="required"/>
			<attribute name="ExtractOffset2Flag" type="integer" use="required"/>
			<attribute name="ExtractOffset3Flag" type="integer" use="required"/>
