			<attribute name="CutCriticalSectionsAtTemplateDrops" type="boolean" use="required"/>
			<attribute name="CutCriticalSectionsAtKeyStations" type="boolean" use="required"/>
			<attribute name="CutCriticalSectionsAtControlPointStations" type="boolean" use="required"/>
