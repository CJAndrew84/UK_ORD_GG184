    <element name="TrapezoidalWeir">
        <annotation>
            <documentation>Contains Pond Routing settings for Trapezoidal Weir</documentation>
        </annotation>
        <complexType>
            <attribute name="ItemName" type="ini:STString31" use="required"/>
            <attribute name="BottomLength" use="required">
                <simpleType>
                    <restriction base="double">
                        <minInclusive value="0.00001"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="NotchHeight" use="required">
                <simpleType>
                    <restriction base="double">
                        <minInclusive value="0.00001"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="RectangularCoefficient" use="required">
                <simpleType>
                    <restriction base="double">
                        <minInclusive value="0.00001"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="Coefficient" use="required">
                <annotation>
                    <documentation>
                        2 = Discharge
                        3 = Triangular
                    </documentation>
                </annotation>
                <simpleType>
                    <restriction base="integer">
                        <minInclusive value="2"/>
                        <maxInclusive value="3"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="DischargeCoefficient" use="required">
                <simpleType>
                    <restriction base="double">
                        <minInclusive value="0.00001"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="TriangularCoefficient" use="required">
                <simpleType>
                    <restriction base="double">
                        <minInclusive value="0.00001"/>
                    </restriction>
                </simpleType>
            </attribute>
            <attribute name="Angle" type="ini:STAngle" use="required"/>
        </complexType>
    </element>
    <element name="TrapezoidalWeirCollection">
        <annotation>
            <documentation>Collection of Pond Routing Trapezoidal Weir preferences</documentation>
        </annotation>
        <complexType>
            <sequence>
                <element ref="ini:TrapezoidalWeir" maxOccurs="unbounded"/>
            </sequence>
        </complexType>
    </element>
</schema>
