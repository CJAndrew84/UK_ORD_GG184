	<element name="SystemPreferences">
		<annotation>
			<documentation>Contains System Preferences settings</documentation>
		</annotation>
		<complexType>
			<sequence>
				<element name="NorthingEasting" type="ini:CTAnnotationPlacement"/>
				<element name="Elevation" type="ini:CTAnnotationPlacement"/>
				<element name="Angular" type="ini:CTAnnotationPlacement"/>
				<element name="Aspect" type="ini:CTAnnotationPlacement"/>
				<element name="Slope" type="ini:CTAnnotationPlacement"/>
				<element name="Linear" type="ini:CTAnnotationPlacement"/>
				<element name="Station" type="ini:CTAnnotationPlacement"/>
				<element name="AcresHectares" type="ini:CTAnnotationPlacement"/>
				<element name="AreaUnits" type="ini:CTAnnotationPlacement"/>
				<element name="CubicUnits" type="ini:CTAnnotationPlacement"/>
				<element name="Scale" type="ini:CTAnnotationPlacement"/>
			</sequence>
			<attribute name="ItemName" type="ini:STString31" use="required"/>
			<attribute name="TabStyle" use="required">
				<annotation>
					<documentation>
                        0 = Not Stacked
                        1 = Stacked
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="AlwaysActivateFirstPage" type="boolean" use="required"/>
			<attribute name="CollapseDialogBoxesAutomatically" type="boolean" use="required"/>
			<attribute name="Editor" use="required">
				<annotation>
					<documentation>
                        0 = Custom
                        1 = Notepad
                        2 = Write
                        3 = Wordpad
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="3"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="EditorName" type="ini:STString255" use="required"/>
			<attribute name="DefaultCell" use="required">
				<simpleType>
					<restriction base="string">
						<maxLength value="15"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="GUICoordinateSequence" use="required">
				<annotation>
					<documentation>
                        0 = Easting/Northing
                        1 = Northing/Easting
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="OmitAutomaticGraphicsRefresh" type="boolean" use="required"/>
			<attribute name="LocatePoint" type="boolean" use="required"/>
			<attribute name="ReTriangulateWithoutPrompting" type="boolean" use="required"/>
			<attribute name="TextScaleLock" type="boolean" use="required"/>
			<attribute name="LinearUnits" use="required">
				<annotation>
					<documentation>
                        0 = Imperial
                        1 = Metric
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="AngularUnits" use="required">
				<annotation>
					<documentation>
                        0 = Degrees
                        1 = Gradients
                        2 = Radians
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="2"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="PlottingHeight" type="double" use="required"/>
			<attribute name="SeedAlignmentName" type="ini:STString63" use="required"/>
			<attribute name="SeedPointName" type="ini:STString23" use="required"/>
			<attribute name="HorizontalCurveDefinition" use="required">
				<annotation>
					<documentation>
                        0 = Chord
                        1 = Arc
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="ConfirmHorizontalCurve" type="boolean" use="required"/>
			<attribute name="VerticalCurveDefinition" use="required">
				<annotation>
					<documentation>
                        0 = Parabolic
                        1 = Circular
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="ConfirmVerticalCurve" type="boolean" use="required"/>
			<attribute name="MeasureCurve" use="required">
				<annotation>
					<documentation>
                        0 = Along Arc
                        1 = Along Chord
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="DegreeOfCurveLength" type="double" use="required"/>
			<attribute name="UnitStationLength" type="double" use="required"/>
			<attribute name="DefineTransitionsBy" use="required">
				<annotation>
					<documentation>
                        0 = Length
                        1 = Constant
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="SpiralDefinition" use="required">
				<annotation>
					<documentation>
                        0 = Clothoid
                        1 = Cubic
                        2 = Bi-quadratic
                        3 = Bloss
                        4 = Sinusoid
                        5 = Cosine
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="7"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="CubicParabolaIs" use="optional">
				<annotation>
					<documentation>
                        0 = Australian
                        1 = Czech
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="ICSCoordinateSequence" use="required">
				<annotation>
					<documentation>
                        0 = Easting/Northing
                        1 = NorthingEasting
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="VerticalAngleReferencePosition" use="required">
				<annotation>
					<documentation>
                        0 = Horizontal
                        1 = Zenith
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="AngularMode" use="required">
				<annotation>
					<documentation>
                        0 = Bearings
                        1 = Bearings North Only
                        2 = Azimuths From North
                        3 = Azimuths From South
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="3"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="CogoPointProtectionFlag" type="integer" use="required"/>
			<attribute name="PointNamesDuringEdits" use="required">
				<annotation>
					<documentation>
                        0 = Do Not Assign
                        1 = Assign
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="DefaultAlignmentAccessMode" use="required">
				<annotation>
					<documentation>
                        0 = read-only
                        1 = read-write
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="DefaultCogoBufferAccessMode" use="required">
				<annotation>
					<documentation>
                        0 = read-only
                        1 = read-write
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="integer">
						<minInclusive value="0"/>
						<maxInclusive value="1"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="PositionalTolerance" type="double" use="required"/>
			<attribute name="HorizontalChordHeightTolerance" type="double" use="required"/>
			<attribute name="VerticalChordHeightTolerance" type="double" use="required"/>
