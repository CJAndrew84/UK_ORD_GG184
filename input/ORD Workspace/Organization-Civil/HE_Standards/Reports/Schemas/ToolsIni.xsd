	<element name="GeneralTracking">
		<annotation>
			<documentation>Contains General Tracking settings</documentation>
		</annotation>
		<complexType>
			<sequence>
				<element name="Northing" type="ini:CTAnnotationPlacement"/>
				<element name="Easting" type="ini:CTAnnotationPlacement"/>
				<element name="Elevation" type="ini:CTAnnotationPlacement"/>
				<element name="Slope" type="ini:CTAnnotationPlacement"/>
				<element name="Aspect" type="ini:CTAnnotationPlacement"/>
				<element name="Station" type="ini:CTAnnotationPlacement"/>
				<element name="Offset" type="ini:CTAnnotationPlacement"/>
				<element name="RightOffset" type="ini:CTAnnotationPlacement"/>
				<element name="DualDimension" type="ini:CTAnnotationPlacement"/>
				<element name="Point">
					<complexType>
						<sequence>
							<choice>
								<group ref="ini:GPointNamedSymbology"/>
								<group ref="ini:GPointSymbology"/>
							</choice>
						</sequence>
					</complexType>
				</element>
				<element name="Text">
					<complexType>
						<sequence>
							<choice>
								<group ref="ini:GTextNamedSymbology"/>
								<group ref="ini:GTextSymbology"/>
							</choice>
						</sequence>
					</complexType>
				</element>
				<element name="Latitude" type="ini:CTAnnotationPlacement"/>
				<element name="Longitude" type="ini:CTAnnotationPlacement"/>
			</sequence>
			<attribute name="ItemName" type="ini:STString31" use="required"/>
			<attribute name="DisplayPoint" type="boolean" use="required"/>
			<attribute name="DisplayText" type="boolean" use="optional"/>
			<attribute name="DisplayNorthing" type="boolean" use="required"/>
			<attribute name="DisplayEasting" type="boolean" use="required"/>
			<attribute name="DisplayElevation" type="boolean" use="required"/>
			<attribute name="DisplaySlope" type="boolean" use="required"/>
			<attribute name="DisplayAspect" type="boolean" use="required"/>
			<attribute name="DisplayStation" type="boolean" use="required"/>
			<attribute name="DisplayOffset" type="boolean" use="required"/>
			<attribute name="DisplayDualDimension" type="boolean" use="required"/>
			<attribute name="DisplayLatitude" type="boolean" use="optional"/>
			<attribute name="DisplayLongitude" type="boolean" use="optional"/>
		</complexType>
	</element>
	<element name="GeneralTrackingCollection">
		<annotation>
