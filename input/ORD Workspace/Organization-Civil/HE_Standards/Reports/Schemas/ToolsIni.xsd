			<attribute name="DualDimensionSuffix" type="ini:STString31" use="required"/>
			<attribute name="DiscontinuityPrefix" type="ini:STString31" use="optional"/>
			<attribute name="DiscontinuitySuffix" type="ini:STString31" use="optional"/>
