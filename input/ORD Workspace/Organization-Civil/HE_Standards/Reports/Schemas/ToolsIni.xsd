<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns:ini="CivilIni" xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="CivilIni" elementFormDefault="qualified">
	<include schemaLocation="CommonIni.xsd"/>
	<element name="XMLGeometryReport">
		<annotation>
			<documentation>Contains XML Geometry Report settings</documentation>
		</annotation>
		<complexType>
			<attribute name="ItemName" type="ini:STString31" use="required"/>
			<attribute name="GeometryOptions" use="required">
				<annotation>
					<documentation>
                        0 = None
                        1 = Include Horizontal Event Points
                        2 = Include Superelevation Alignments
                        4 = Include Vertical Alignments
                        8 = Interval
                        16 = Include Vertical Event Points
                        32 = Include Active Superelevation Only
                        64 = Include Active Vertical Alignment Only
                        Values are cummulative
                    </documentation>
				</annotation>
				<simpleType>
					<restriction base="unsignedLong">
						<minInclusive value="0"/>
						<maxInclusive value="127"/>
					</restriction>
				</simpleType>
			</attribute>
			<attribute name="GeometryInterval" type="ini:STNonnegativeDouble" use="required"/>
		</complexType>
	</element>
	<element name="XMLGeometryReportCollection">
		<annotation>
			<documentation>Collection of XML Geometry Report preferences</documentation>
		</annotation>
		<complexType>
			<sequence>
				<element ref="ini:XMLGeometryReport" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
