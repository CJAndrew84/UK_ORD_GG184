			<attribute name="ComputeTurnoutsBasedOnMainlineCant" type="boolean" use="required"/>
			<attribute name="ForceColinearity" type="boolean" use="optional"/>
			<attribute name="IndependentNonLinears" type="boolean" use="optional"/>
			<attribute name="SlewSignage" type="boolean" use="optional"/>
			<attribute name="InterpolateSpeed" type="boolean" use="optional"/>
			<attribute name="StationDelimiter" type="ini:STString31" use="optional"/>
			<attribute name="EyeHeight" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="StoppingObjectHeight" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="PassingObjectHeight" type="ini:STNonnegativeDouble" use="required"/>
