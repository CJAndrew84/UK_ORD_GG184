			<attribute name="BlockScaleX" type="double" use="required"/>
			<attribute name="BlockScaleY" type="double" use="required"/>
			<attribute name="BlockScaleZ" type="double" use="required"/>
			<attribute name="EqualScales" type="integer" use="required"/>
			<attribute name="PerMille" type="ini:STString31" use="required"/>
			<attribute name="PC" type="ini:STString31" use="required"/>
			<attribute name="PI" type="ini:STString31" use="required"/>
			<attribute name="CC" type="ini:STString31" use="required"/>
			<attribute name="PT" type="ini:STString31" use="required"/>
			<attribute name="TS" type="ini:STString31" use="required"/>
			<attribute name="SC" type="ini:STString31" use="required"/>
			<attribute name="CS" type="ini:STString31" use="required"/>
