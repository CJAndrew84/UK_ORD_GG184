			<attribute name="EquilibriumConstant" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="AppliedConstant" type="ini:STNonnegativeDouble" use="required"/>
			<attribute name="CantRoundingConstant" type="ini:STNonnegativeDouble" use="required"/>
